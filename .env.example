# Copy to .env for local configuration. Never commit .env.
PORT=3000
ENFORCE_HTTPS=false
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:5173
MAX_BODY_BYTES=16384
RATE_LIMIT_WINDOW_MS=60000
